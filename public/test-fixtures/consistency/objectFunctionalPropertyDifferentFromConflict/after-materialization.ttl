# Check: objectFunctionalPropertyDifferentFromConflict
# Case: after-materialization
# Expected target finding: before=False, after=True
# Finding kind: contradiction
# Materialization rules: subpropertyof

@prefix ex: <https://example.org/consistency-fixture/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:p a owl:ObjectProperty, owl:FunctionalProperty .
ex:q a owl:ObjectProperty; rdfs:subPropertyOf ex:p .
ex:x ex:p ex:a; ex:q ex:b .
ex:a owl:differentFrom ex:b .
