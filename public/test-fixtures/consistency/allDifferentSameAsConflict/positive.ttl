# Check: allDifferentSameAsConflict
# Case: positive
# Expected target finding: before=True, after=True
# Finding kind: contradiction
# Materialization rules: none

@prefix ex: <https://example.org/consistency-fixture/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:set a owl:AllDifferent; owl:distinctMembers (ex:a ex:b) .
ex:a owl:sameAs ex:b .
